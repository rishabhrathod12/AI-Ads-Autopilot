# Placeholders only. Never commit real values. Copy to .env.production (gitignored).
# Use long random values; they are placed in URLs, so avoid characters that need URL-encoding
# (@ : / ? # %) or percent-encode them.

# Bootstrap (superuser) password for the database container; used by the migrate and roles jobs only.
POSTGRES_PASSWORD=
# Password for the limited `adpilot_app` login role the API connects as.
APP_DB_PASSWORD=

# JWT authentication (required: the API refuses to start in production without all three).
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWKS_URL=
# Where the verified email is in the token (docs/AUTH_SETUP.md); used to link invited users.
AUTH_EMAIL_CLAIM=email
AUTH_EMAIL_VERIFIED_CLAIM=email_verified
# Public sign-in identifiers for the frontend image (build args; docs/AUTH_SETUP.md). Not secrets.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Browser origins allowed to call the API (JSON list). Usually empty if the frontend proxies /api.
CORS_ORIGINS=[]

# Optional LLM assistant (off by default). See .env.example for the other LLM_* settings, which
# can also be placed in this file.
LLM_PROVIDER=none
