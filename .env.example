# Placeholders only. Never commit real values. Copy to .env (gitignored).
APP_ENV=development
ADS_PROVIDER=mock
AD_EXECUTION_ENABLED=false

# Docker Compose requires this (choose any strong local value).
POSTGRES_PASSWORD=

# Backend run outside Docker (SQLAlchemy asyncpg URL).
DATABASE_URL=
DB_APP_ROLE=adpilot_app

# LLM assistant (M4). Off by default: nothing is sent to any provider unless you set this up.
# LLM_PROVIDER: none | openai. LLM_MODEL must support tool calling and structured outputs.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
# Prices are required (they power the spend cap); copy them from your provider's price list.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Knowledge search. EMBEDDING_PROVIDER: none | hashing (offline, dev only) | openai.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_USD_PER_MILLION=
LLM_DAILY_CAP_USD=1
LLM_MONTHLY_CAP_USD=5
# Authentication (ADR 0021): set ALL THREE or none. With none, development mode uses a tenant header.
# Required for APP_ENV=production. The JWKS URL must be https.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWKS_URL=
# Claims carrying the verified email (ADR 0026, docs/AUTH_SETUP.md). Auth0 needs namespaced names.
AUTH_EMAIL_CLAIM=email
AUTH_EMAIL_VERIFIED_CLAIM=email_verified

# Amazon Ads API (M9): OFF. Real connectivity is NOT implemented; see docs/AMAZON_ADS_INTEGRATION.md.
# Setting ADS_PROVIDER=amazon requires AMAZON_ADS_ENABLED=true and every value below, or startup is refused.
AMAZON_ADS_ENABLED=false
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_TOKEN_URL=
AMAZON_ADS_API_BASE_URL=
# JSON {"1": "<base64 of 32 random bytes>"}; the active id selects the key used for new tokens.
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KID=
