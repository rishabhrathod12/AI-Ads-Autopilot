# Placeholders only. Never commit real values. Copy to .env (gitignored).
APP_ENV=development
ADS_PROVIDER=mock
AD_EXECUTION_ENABLED=false

# Docker Compose requires this (choose any strong local value).
POSTGRES_PASSWORD=

# Backend run outside Docker (SQLAlchemy asyncpg URL).
DATABASE_URL=
DB_APP_ROLE=adpilot_app

# LLM assistant (M4). Off by default: nothing is sent to any provider unless you set this up.
# LLM_PROVIDER: none | openai. LLM_MODEL must support tool calling and structured outputs.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
# Prices are required (they power the spend cap); copy them from your provider's price list.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Knowledge search. EMBEDDING_PROVIDER: none | hashing (offline, dev only) | openai.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_USD_PER_MILLION=
LLM_DAILY_CAP_USD=1
LLM_MONTHLY_CAP_USD=5
AUTH_JWT_ISSUER=
